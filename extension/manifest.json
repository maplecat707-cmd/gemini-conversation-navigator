{
  "manifest_version": 3,
  "name": "Gemini 对话目录 · Gemini Anchor",
  "version": "0.1.1",
  "description": "为 Gemini 长对话添加可搜索的侧边目录，点击提问回到原位置。仅本机处理。",
  "permissions": ["storage"],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "展开 / 收起 Gemini 对话目录" },
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [{
    "matches": ["https://gemini.google.com/*"],
    "js": ["src/content.js"],
    "run_at": "document_idle"
  }],
  "commands": {
    "toggle-sidebar": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "展开 / 收起对话目录"
    }
  }
}
